# Supabase (Project Settings → API). The service-role key stays on the server only.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Clerk (dashboard.clerk.com → API keys). Enable Google under User & authentication → SSO connections.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# Who may use the app (comma-separated Google emails)
ALLOWED_EMAILS=

# Morning (Green Invoice) — Personal area → Developer tools → API keys
MORNING_API_KEY_ID=
MORNING_API_SECRET=
# production | sandbox
MORNING_ENV=production
# 320 = חשבונית מס/קבלה, 400 = קבלה (עוסק פטור)
MORNING_DOC_TYPE=320

# Gemini (screenshot reading)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Used in WhatsApp messages
STUDIO_SIGNATURE=גליה
STUDIO_PHONE=
